{
  "Bridge": {
    "WebSocketPort": 9527,
    "DriverDeviceName": "\\\\.\\SecurityDriver",
    "PollIntervalMs": 500,
    "HeartbeatIntervalSec": 30,
    "UseMockDriver": true
  },
  "ETW": {
    // 总开关：false = 完全关闭 ETW 监控（非 Windows 环境自动跳过，无需手动关闭）
    "Enabled": true,
    // ETW 会话名称（全局唯一，重名会话需先清理）
    "SessionName": "SecurityBridgeETW"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
