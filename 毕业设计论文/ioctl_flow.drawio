<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" version="21.0.0">
  <diagram id="ioctl" name="Ring0-Ring3数据穿越">
    <mxGraphModel dx="1200" dy="600" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1440" pageHeight="560" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- ========== Ring 0 Section ========== -->
        <mxCell id="r0" value="Ring 0  ·  内核态（LLMHips.sys）"
          style="swimlane;startSize=28;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;fontStyle=1;align=left;spacingLeft=12;"
          vertex="1" parent="1">
          <mxGeometry x="20" y="20" width="1400" height="170" as="geometry"/>
        </mxCell>

        <mxCell id="k1" value="进程创建事件&#xa;PsSetCreateProcessNotifyRoutineEx&#xa;回调触发（同步）"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;fontStyle=1;"
          vertex="1" parent="r0">
          <mxGeometry x="20" y="46" width="210" height="90" as="geometry"/>
        </mxCell>

        <mxCell id="k2" value="填充 PROCESS_INFO 结构体&#xa;PID · PPID · ImagePath&#xa;CommandLine · SessionId"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;"
          vertex="1" parent="r0">
          <mxGeometry x="270" y="46" width="210" height="90" as="geometry"/>
        </mxCell>

        <mxCell id="k3" value="SPSC Ring Buffer ★&#xa;无锁写入进程数据&#xa;IRQL = DISPATCH_LEVEL 安全"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;fontStyle=1;"
          vertex="1" parent="r0">
          <mxGeometry x="520" y="46" width="210" height="90" as="geometry"/>
        </mxCell>

        <mxCell id="k4" value="KEVENT 内核事件&#xa;KeSetEvent()&#xa;通知用户态：数据就绪"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;"
          vertex="1" parent="r0">
          <mxGeometry x="770" y="46" width="210" height="90" as="geometry"/>
        </mxCell>

        <!-- Arrows within Ring 0 -->
        <mxCell id="ek12" value="写入" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=9;" edge="1" parent="r0" source="k1" target="k2">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="ek23" value="入队" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=9;" edge="1" parent="r0" source="k2" target="k3">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="ek34" value="触发" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=9;" edge="1" parent="r0" source="k3" target="k4">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- ========== Boundary separator ========== -->
        <mxCell id="boundary" value="⚠️  内核态 / 用户态内存完全隔离  ·  不可直接传递指针  ·  必须经由系统调用拷贝"
          style="text;html=1;strokeColor=#FF0000;fillColor=#FFE6CC;align=center;verticalAlign=middle;rounded=1;fontSize=11;fontStyle=1;fontColor=#AE4132;dashed=1;strokeWidth=2;"
          vertex="1" parent="1">
          <mxGeometry x="20" y="200" width="1400" height="28" as="geometry"/>
        </mxCell>

        <!-- ========== Ring 3 Section ========== -->
        <mxCell id="r3" value="Ring 3  ·  用户态（C# SecurityBridge）"
          style="swimlane;startSize=28;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontStyle=1;align=left;spacingLeft=12;"
          vertex="1" parent="1">
          <mxGeometry x="20" y="238" width="1400" height="195" as="geometry"/>
        </mxCell>

        <mxCell id="u1" value="KeWaitForSingleObject&#xa;阻塞等待 KEVENT 信号&#xa;零 CPU 占用挂起"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;"
          vertex="1" parent="r3">
          <mxGeometry x="20" y="46" width="210" height="90" as="geometry"/>
        </mxCell>

        <mxCell id="u2" value="DeviceIoControl() ★&#xa;P/Invoke 调用 Win32 API&#xa;\\\\.\\LLMHips 设备句柄"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;fontStyle=1;"
          vertex="1" parent="r3">
          <mxGeometry x="270" y="46" width="210" height="90" as="geometry"/>
        </mxCell>

        <mxCell id="u3" value="METHOD_BUFFERED ★&#xa;内核负责内存安全拷贝&#xa;用户态无法访问内核地址"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;fontStyle=1;"
          vertex="1" parent="r3">
          <mxGeometry x="520" y="46" width="210" height="90" as="geometry"/>
        </mxCell>

        <mxCell id="u4" value="BinaryReader 反序列化&#xa;结构体字段类型安全提取&#xa;PID / 路径 / 命令行还原"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;"
          vertex="1" parent="r3">
          <mxGeometry x="770" y="46" width="210" height="90" as="geometry"/>
        </mxCell>

        <mxCell id="u5" value="JSON 序列化&#xa;ProcessInfo → JSON&#xa;WebSocket 广播 :9527"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;"
          vertex="1" parent="r3">
          <mxGeometry x="1020" y="46" width="210" height="90" as="geometry"/>
        </mxCell>

        <!-- Arrows within Ring 3 -->
        <mxCell id="eu12" value="唤醒" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=9;" edge="1" parent="r3" source="u1" target="u2">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="eu23" value="系统拷贝" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=9;" edge="1" parent="r3" source="u2" target="u3">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="eu34" value="解析" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=9;" edge="1" parent="r3" source="u3" target="u4">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="eu45" value="广播" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=9;" edge="1" parent="r3" source="u4" target="u5">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- ========== Cross-boundary arrows ========== -->
        <!-- KEVENT → KeWait -->
        <mxCell id="e_kevent" value="KEVENT 唤醒"
          style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;fontStyle=1;strokeColor=#FF8000;strokeWidth=2;"
          edge="1" parent="1" source="k4" target="u1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Ring Buffer → METHOD_BUFFERED (main IOCTL crossing) -->
        <mxCell id="e_ioctl" value="IOCTL 数据穿越"
          style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;fontStyle=1;strokeColor=#b85450;strokeWidth=3;"
          edge="1" parent="1" source="k3" target="u3">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- ========== Bottom conclusion ========== -->
        <mxCell id="conclusion"
          value="METHOD_BUFFERED 由 Windows 内核全程负责内存拷贝，用户态程序无需也无法直接访问内核地址空间，从根本上保证跨特权级数据传输的安全性"
          style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=11;fontStyle=1;fontColor=#23445D;"
          vertex="1" parent="1">
          <mxGeometry x="20" y="445" width="1400" height="28" as="geometry"/>
        </mxCell>

        <!-- Legend -->
        <mxCell id="legend"
          value="★ 重点设计模块    橙色箭头 = 事件通知    红色粗箭头 = 数据跨界传输"
          style="text;html=1;strokeColor=none;fillColor=none;align=right;fontSize=10;fontColor=#666666;"
          vertex="1" parent="1">
          <mxGeometry x="900" y="490" width="520" height="20" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
